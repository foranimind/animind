[Unit]
Description=Animind Local Relay
After=network.target

[Service]
Type=simple
User=animind
Group=animind
WorkingDirectory=/srv/animind/app
EnvironmentFile=/etc/animind/animind.relay.env
ExecStart=/usr/bin/python3 -m uvicorn services.relay.src.main:app --host 127.0.0.1 --port 9000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
